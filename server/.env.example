# Server
PORT=5001
NODE_ENV=development

# Database (local MySQL or TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=noor_db

# TiDB Cloud (Frankfurt example — copy values from Console → Connect → General)
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=YOUR_CLUSTER_ID.root
# DB_PASSWORD=your_cluster_password
# DB_NAME=noor_db
# DB_ENABLE_SSL=true

# Security
JWT_SECRET=change_me_to_a_long_random_string
